ENV=hml
APP_NAME=ecargo-analytics
NAMESPACE=hml-signa-ecargo
SECRET_NAME=ecargo-analytics-secrets
IMAGE=ghcr.io/edubytes-vasconcelos/ecargo-analytics:79f582c83b0af99096c9971cc99b2016ca27fa69
REPLICAS=1
BASE_PATH=/ecargo-analytics
INGRESS_HOST=ecargohml.k8s.loginlogistica.com.br
INGRESS_CLASS=kong
TLS_SECRET=lets-login
GATEWAY_NAME=kong-gateway
GATEWAY_NAMESPACE=kong
STORAGE_SIZE=2Gi
SMTP_HOST=login-relay01.loginlogistica.com.br
SMTP_PORT=25
SMTP_STARTTLS=1
SMTP_FROM=Projetos_ecargo@loginlogistica.com.br
APP_PUBLIC_URL=https://ecargohml.k8s.loginlogistica.com.br/ecargo-analytics/projetos
SYNC_INTERVAL_SECONDS=600
SYNC_LOOKBACK_HOURS=2
