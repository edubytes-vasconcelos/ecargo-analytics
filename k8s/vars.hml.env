ENV=hml
APP_NAME=ecargo-analytics
NAMESPACE=hml-signa-ecargo
SECRET_NAME=ecargo-analytics-secrets
IMAGE=ghcr.io/edubytes-vasconcelos/ecargo-analytics:4be1a20694da59a817f3539fb580b125469c0258
REPLICAS=1
BASE_PATH=/ecargo-analytics
INGRESS_HOST=ecargohml.k8s.loginlogistica.com.br
INGRESS_CLASS=kong
TLS_SECRET=lets-login
GATEWAY_NAME=kong-gateway
GATEWAY_NAMESPACE=kong
STORAGE_SIZE=2Gi
SYNC_INTERVAL_SECONDS=600
SYNC_LOOKBACK_HOURS=2
